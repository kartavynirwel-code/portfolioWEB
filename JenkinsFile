pipeline {
    agent any

    environment {
        KUBECONFIG = "/var/lib/jenkins/.kube/config"

        DOCKER_TLS_VERIFY = "1"
        DOCKER_HOST = "tcp://192.168.49.2:2376"
        DOCKER_CERT_PATH = "/home/ubuntu/.minikube/certs"
        MINIKUBE_ACTIVE_DOCKERD = "minikube"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh './mvnw clean package -DskipTests'
            }
        }

        stage('Docker Build & Deploy') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github-token',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {

                    sh '''
                        echo "Testing Kubernetes Access..."
                        kubectl get nodes

                        echo "Building Docker Image..."
                        docker build -t my-boot:latest .

                        echo "Updating Secret..."
                        kubectl create secret generic github-secret \
                          --from-literal=GITHUB_TOKEN="$GITHUB_TOKEN" \
                          --dry-run=client -o yaml | kubectl apply -f -

                        echo "Deploying Application..."
                        kubectl delete deployment spring-app --ignore-not-found=true

                        kubectl apply -f K8s/Deployment.yaml

                        kubectl apply -f K8s/Service.yaml

                        kubectl rollout status deployment/spring-app
                    '''
                }
            }
        }
    }

    post {
        success {
            mail to: 'kartavynirwel77@gmail.com',
                 subject: "Build #${BUILD_NUMBER} Successful!",
                 body: "Website update ho gayi!\nBuild: ${BUILD_URL}"
        }

        failure {
            mail to: 'kartavynirwel77@gmail.com',
                 subject: "Build #${BUILD_NUMBER} Failed!",
                 body: "Build fail ho gayi!\nCheck karo: ${BUILD_URL}"
        }
    }
}
